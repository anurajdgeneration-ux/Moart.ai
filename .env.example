.env.example
DATABASE_URL="postgresql://user:password@localhost:5432/moart_ai"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Replicate API (for AI image generation)
REPLICATE_API_TOKEN="your-replicate-api-token-here"

# Instagram OAuth
INSTAGRAM_CLIENT_ID="your_instagram_app_id"
INSTAGRAM_CLIENT_SECRET="your_instagram_app_secret"

# TikTok OAuth
TIKTOK_CLIENT_ID="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"

# YouTube OAuth
YOUTUBE_CLIENT_ID="your_youtube_client_id"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"

# Facebook OAuth
FACEBOOK_CLIENT_ID="your_facebook_app_id"
FACEBOOK_CLIENT_SECRET="your_facebook_app_secret"

# Music APIs
EPIDEMIC_SOUND_API_KEY="your_epidemic_sound_api_key"
PIXABAY_MUSIC_API_KEY="your_pixabay_music_api_key"

# Application
NODE_ENV="development"

# Public URLs for OAuth (used in browser)
NEXT_PUBLIC_INSTAGRAM_CLIENT_ID="your_instagram_app_id"
NEXT_PUBLIC_TIKTOK_CLIENT_ID="your_tiktok_client_key"
NEXT_PUBLIC_YOUTUBE_CLIENT_ID="your_youtube_client_id"
NEXT_PUBLIC_FACEBOOK_CLIENT_ID="your_facebook_app_id"
NEXT_PUBLIC_NEXTAUTH_URL="http://localhost:3000"
